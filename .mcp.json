{
  "mcpServers": {
    "advisor": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/advisor_server.py"],
      "env": {
        "ADVISOR_PROVIDER": "${user_config.advisor_provider}",
        "ADVISOR_MODEL": "${user_config.advisor_model}",
        "ADVISOR_BASE_URL": "${user_config.advisor_base_url}",
        "ADVISOR_API_KEY": "${user_config.advisor_api_key}",
        "ADVISOR_LOG": "${CLAUDE_PLUGIN_DATA}/consult-log.jsonl"
      }
    }
  }
}
